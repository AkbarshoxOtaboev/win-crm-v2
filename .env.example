# Copy to VDS as .env next to the JAR:
#   scp .env.example user@vds:/opt/wincrm/.env
#
# Then edit passwords/secrets on the server.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5432/wincrm_db
DB_USERNAME=wincrm
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT (min ~32+ chars / 256-bit secret)
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# File uploads (absolute path on VDS)
FILE_UPLOAD_DIR=/var/wincrm/uploads

# Eskiz SMS
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_FROM=ABATSTEKLO
ESKIZ_ENCRYPTION_SECRET=CHANGE_ME_ESKIZ_ENCRYPTION_SECRET

# CORS — comma-separated origins (same-origin JAR UI usually needs your public URL)
CORS_ALLOWED_ORIGINS=https://your-domain.uz,http://your-domain.uz

# Optional Telegram bot token encryption
TELEGRAM_BOT_ENCRYPTION_SECRET=CHANGE_ME_TELEGRAM_SECRET
